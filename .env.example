# Public Supabase client configuration (safe to expose in the browser).
# Leave both empty to run the app in local MOCK mode without a database.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- Server-side secrets (NEVER prefix with VITE_, never commit real values) ----
# Set these in Supabase: Project Settings -> Edge Functions -> Secrets
# ADMIN_PASSWORD=choose-a-long-password
